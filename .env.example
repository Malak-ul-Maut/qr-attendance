# Copy this file to .env. Uncomment a setting to override its default.
# Keep credentials and machine-specific paths in .env; never commit them.

# Rotating QR (all optional)
# QR_FRAME_MS=400               # how often the QR on the faculty screen changes
# QR_FRAME_LIFETIME_MS=4000     # how long a frame can still be redeemed (covers slow Wi-Fi)
# QR_FRAMES_REQUIRED=2          # different frames a phone must hand in (1-4). 1 allows photos again; 3 is stricter

# HTTPS server and public tunnel
PORT=4000
TUNNEL=ngrok                 # ngrok | cloudflared | zrok | none
NGROK_AUTHTOKEN=             # Required for ngrok; get this from your ngrok dashboard
NGROK_DOMAIN=                # Optional registered ngrok domain
ADMIN_SESSION_SECRET=         # Set a long random secret to preserve admin sessions across restarts
SERVE_DIST=0                 # Set to 1 to serve frontend-dist after npm run build

Face enrollment
GALLERY_DIR=                 # Default: backend/gallery
FACE_DUPLICATE_THRESHOLD=0.6 # Similarity threshold for duplicate enrollment warnings

# Optional CCTV recognition service
CCTV_SPAWN_SERVICE=true       # Set false when running the Python service separately
# CCTV_PYTHON=python            # Python executable; e.g. venv/Scripts/python.exe on Windows
# CCTV_SERVICE_SCRIPT=          # Default: backend/server.py
# CCTV_SERVICE_URL=http://127.0.0.1:8765
# CCTV_SERVICE_STARTUP_WAIT_MS=120000
CCTV_SOURCE=clip              # clip | auto | live
CCTV_TEST_CLIP=                # Default: backend/f310.avi
CCTV_RECOGNIZE_TIMEOUT_MS=300000

# CCTV face recognition models and acceleration
# CCTV_BACKEND=auto             # auto | openvino | onnxruntime
# CCTV_DEVICE=AUTO              # Any OpenVINO device string, e.g. AUTO, GPU, CPU
# CCTV_PRECISION=auto           # auto | f32 | f16
# CCTV_OV_BATCHES=1,4,8,16      # OpenVINO recognizer batch sizes
# CCTV_OV_CACHE=                # Default: backend/cache/openvino
# CCTV_MODELS_DIR=              # Default: backend/models
# CCTV_REC_MODEL=cvlface_adaface_ir101_webface12m.onnx
# CCTV_DET_SIZE=1920x1080
# CCTV_DET_THRESH=0.3
# CCTV_KEYPOINTS=detected       # detected | template (only applies to keypoint-input models)
# CCTV_GALLERY_DIR=             # Default: backend/gallery
# CCTV_GALLERY_DEGRADE=         # Optional comma-separated widths, e.g. 20,28

# CCTV live-camera connections and diagnostics
# CCTV_SERVICE_PORT=8765        # The spawned service derives this from CCTV_SERVICE_URL
# CCTV_STREAM_IDLE_SEC=600
# CCTV_MAX_STREAMS=12
# CCTV_SNAPSHOT_DIR=             # Optional per-frame debug snapshots
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|fflags;nobuffer|flags;low_delay

# CCTV output and gallery updates
# CCTV_ANNOTATED_DIR=           # Default: backend/results
# CCTV_CROPS_DIR=               # Default: backend/crop-staging
# CCTV_MAX_GALLERY_CROPS=8      # Maximum saved CCTV crops per student
# CCTV_GROW_GALLERY=on           # Set off to disable gallery growth
# CCTV_GROW_MIN_SCORE=0.35
# CCTV_GROW_MIN_FACE_PX=30
# CCTV_GROW_MIN_QUALITY=0        # Set above 0 to reject low-quality crops

# CCTV_EXIT_WITH_PARENT is set internally when the Node server starts the Python service.
