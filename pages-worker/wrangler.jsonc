{
  "name": "smart-attendance-marker",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../frontend-dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/results/*",
      "/socket.io/*"
    ]
  },
  "vars": {
    "ORIGIN": "https://scrimmage-unlucky-dispersed.ngrok-free.dev"
  }
}
